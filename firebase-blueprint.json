{
  "entities": {
    "User": {
      "title": "User",
      "description": "Patron user profile, cart, wishlist, and preferences",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "cartItems": { "type": "array" },
        "wishlistItems": { "type": "array" },
        "savedAddresses": { "type": "array" },
        "lastActiveAt": { "type": "string" }
      },
      "required": ["email"]
    },
    "Order": {
      "title": "Order",
      "description": "High jewelry patron orders and tracking lifecycle",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "date": { "type": "string" },
        "status": { 
          "type": "string",
          "enum": ["Confirmed", "Accepted", "Crafting", "Dispatched", "Out for Delivery", "Delivered", "Cancelled"]
        },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shippingFee": { "type": "number" },
        "discount": { "type": "number" },
        "tax": { "type": "number" },
        "total": { "type": "number" },
        "shippingAddress": { "type": "object" },
        "paymentMethod": { "type": "string" },
        "trackingNumber": { "type": "string" },
        "estimatedDelivery": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "orderNumber", "total", "status"]
    },
    "Product": {
      "title": "Product",
      "description": "Artisanal fine jewellery catalog piece",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "metal": { "type": "string" },
        "stockCount": { "type": "number" },
        "inStock": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "price"]
    },
    "NewsletterSubscriber": {
      "title": "NewsletterSubscriber",
      "description": "Atelier newsletter subscriber",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "subscribedAt": { "type": "string" }
      },
      "required": ["email"]
    },
    "Seller": {
      "title": "Seller",
      "description": "Certified atelier artisan & seller partner account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storeName": { "type": "string" },
        "ownerName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" },
        "rating": { "type": "number" },
        "city": { "type": "string" },
        "commissionRate": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "storeName", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores patron account data, carts, wishlists, and addresses"
    },
    "/sellers/{sellerId}": {
      "schema": "Seller",
      "description": "Stores registered artisan & seller partner accounts"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Stores confirmed atelier jewellery orders"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Stores custom and atelier jewellery catalog products"
    },
    "/newsletterSubscribers/{subId}": {
      "schema": "NewsletterSubscriber",
      "description": "Stores newsletter subscription emails"
    }
  }
}
