<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100%" height="100%">
  <defs>
    <!-- Sticker Drop Shadow -->
    <filter id="nStickerShadow" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="2.5" stdDeviation="2.5" floodColor="#000000" floodOpacity="0.22" />
    </filter>
  </defs>

  <!-- Group with sticker drop shadow -->
  <g filter="url(#nStickerShadow)">
    <!-- 1. Smooth White Die-Cut Sticker Outline Contour for 'N' -->
    <path
      d="M 28 74 
         C 27 50, 28 32, 34 23 
         C 38 18, 43 20, 47 28 
         L 67 67 
         C 71 75, 76 77, 78 70 
         L 82 25"
      fill="none"
      stroke="#FFFFFF"
      stroke-width="24"
      stroke-linecap="round"
      stroke-linejoin="round"
    />

    <!-- Secondary white filler to ensure solid center between tight bends -->
    <path
      d="M 28 74 C 27 50, 28 32, 34 23 C 38 18, 43 20, 47 28 L 67 67 C 71 75, 76 77, 78 70 L 82 25 Z"
      fill="#FFFFFF"
    />

    <!-- 2. Crimson / Dark Red Accent Outline (Matching User Reference Style) -->
    <path
      d="M 25 64 
         C 24 44, 27 28, 33 20 
         C 38 14, 45 16, 50 24 
         L 70 64 
         C 73 72, 78 73, 81 67 
         L 85 22"
      fill="none"
      stroke="#880020"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />

    <!-- Inner fold red accent -->
    <path
      d="M 40 26 
         L 64 68 
         C 68 74, 73 75, 76 69"
      fill="none"
      stroke="#B0002A"
      stroke-width="1.8"
      stroke-linecap="round"
    />

    <!-- 3. Main 'N' Bold Calligraphic Letterform in Deep Black -->
    <path
      d="M 28 74 
         C 27 50, 28 32, 34 23 
         C 38 18, 43 20, 47 28 
         L 67 67 
         C 71 75, 76 77, 78 70 
         L 82 25"
      fill="none"
      stroke="#111111"
      stroke-width="13"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </g>
</svg>
