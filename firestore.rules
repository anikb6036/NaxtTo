rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User private profiles and synchronization data
    match /users/{userId} {
      allow read, write: if true;
    }

    // Sellers & artisan partners directory
    match /sellers/{sellerId} {
      allow read, write: if true;
    }

    // Orders collection:
    // Anyone can create an order (guests and logged-in patrons)
    // Anyone can read orders (for order confirmation, tracking, and atelier admin management)
    // Admin or patron can update order status (such as status, tracking, or delivery updates)
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Products collection:
    // Anyone can read product catalog
    // Atelier admins can create, update, or delete products
    match /products/{productId} {
      allow read, write: if true;
    }

    // Deleted products tombstone log for catalog-wide deletion sync
    match /deleted_products/{productId} {
      allow read, write: if true;
    }

    // Newsletter subscribers
    match /newsletterSubscribers/{subId} {
      allow read, write: if true;
    }

    // Email notifications dispatched by Cloud Functions / Atelier Mailer
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Dynamic SEO and Site Settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
